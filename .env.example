# KeyStats Configuration
# ======================
# Copy this file to .env and edit values below.
# Changes take effect automatically on next launch.

# Window Geometry (last known position & dimensions; persisted automatically)
WINDOW_X=0
WINDOW_Y=0
WINDOW_WIDTH=1120
WINDOW_HEIGHT=680

# Appearance — dark | light | auto
THEME=dark
# Color Scheme — indigo | ocean | emerald | amber | rose
COLOR_SCHEME=indigo
FONT_FAMILY=JetBrains Mono

# Language — auto | en | zh
LANGUAGE=auto

# Behavior
START_MINIMIZED=false
AUTO_START=false

# Data Storage — set to true to store data next to the executable
# PORTABLE_MODE=false
